# ──────────────────────────────────────────────────────────────
# GitHub OAuth Star-Gate
# ──────────────────────────────────────────────────────────────

# GitHub OAuth App credentials (create at https://github.com/settings/developers)
# Callback URL should be: ${NEXT_PUBLIC_BASE_URL}/api/auth/github/callback
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Random 32-byte secret used to sign session cookies (generate with: openssl rand -hex 32)
AUTH_SECRET=your_random_32_byte_secret_hex

# The GitHub repo to verify stars against (owner/repo format)
NEXT_PUBLIC_GITHUB_REPO=xitanggg/open-resume

# Your deployment base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ──────────────────────────────────────────────────────────────
# Self-host kill-switch
# Set to "1" to bypass the star-gate entirely (for self-hosted deployments)
# ──────────────────────────────────────────────────────────────
# NEXT_PUBLIC_DISABLE_STAR_GATE=1

# ──────────────────────────────────────────────────────────────
# AI providers (optional — users can also supply their own keys in the UI)
# ──────────────────────────────────────────────────────────────
# OPENROUTER_API_KEY=your_openrouter_api_key
